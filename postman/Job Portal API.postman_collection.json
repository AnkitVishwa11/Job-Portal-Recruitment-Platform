              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"phone\": \"+0987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
