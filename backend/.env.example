# Copy this file to .env and fill in your values
# Never commit your actual .env file to Git

NODE_ENV=production
PORT=10000

# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobportal?retryWrites=true&w=majority

# JWT Secrets — use long random strings in production
JWT_SECRET=<generate_a_strong_random_secret>
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=<generate_a_different_strong_random_secret>
JWT_REFRESH_EXPIRE=7d

# Cookie secret
COOKIE_SECRET=<generate_a_strong_random_secret>

# Your deployed Netlify frontend URL (e.g. https://your-app.netlify.app)
CLIENT_URL=https://your-app.netlify.app

# File upload settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
