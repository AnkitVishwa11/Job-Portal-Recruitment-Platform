{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "Job Portal / Recruitment Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "set NODE_ENV=test&& npx jest --config jest.config.js --detectOpenHandles",
    "test:watch": "set NODE_ENV=test&& npx jest --config jest.config.js --watch",
    "test:coverage": "set NODE_ENV=test&& npx jest --config jest.config.js --coverage",
    "lint": "npx eslint src/ --ext .js",
    "lint:fix": "npx eslint src/ --ext .js --fix"
  },
  "keywords": [
    "job-portal",
    "recruitment",
    "api",
    "express",
    "mongodb"
  ],
  "author": "Job Portal Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
